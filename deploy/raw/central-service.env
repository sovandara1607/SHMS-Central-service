# Copy this to /var/www/central-service/.env on centralservice-api-server and
# fill in every value. Same values as the Docker deployment's
# docker-compose.central.yml `environment:` block, reshaped into a real
# .env file for native PHP-FPM to read directly.

APP_NAME=central-service
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:REPLACE_ME
APP_URL=http://CENTRAL_SERVICE_HOST:8100

DB_CONNECTION=pgsql
DB_HOST=POSTGRES_HOST
DB_PORT=5432
DB_DATABASE=smart_hospital
DB_USERNAME=smart_hospital
DB_PASSWORD=REPLACE_ME

MONGODB_URI=mongodb://smart_hospital:REPLACE_ME@MONGO_HOST:27017/?authSource=admin
MONGODB_DATABASE=smart_hospital_docs

REDIS_CLIENT=phpredis
REDIS_HOST=REDIS_HOST
REDIS_PASSWORD=REPLACE_ME
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_BUS_DB=2

# Deliberately array/array, not redis — see DropdownCache.php's docblock in
# this repo for why anything that DOES need cross-request Redis caching
# there explicitly targets Cache::store('redis') instead of the default.
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local

CENTRAL_SERVICE_API_KEY=REPLACE_ME

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

MAIL_MAILER=log
